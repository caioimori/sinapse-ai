#!/usr/bin/env sh
#
# pre-push hook
#
# Runs three groups of safety checks before allowing a push:
#
#   1. pre-push-safety.js   - branch/safety net
#   2. validate:all         - 6 lint guards in parallel (Sessao 2 / PR 2.2):
#                               * no-external-refs
#                               * no-personal-leaks
#                               * orqx-discipline
#                               * cross-refs
#                               * manifest:parity
#                               * squad-yaml
#   3. validate:parity:fast - cross-IDE drift guard (only when agent files changed)
#
# Group 2 used to be 6 sequential `npm run` calls (~12-18 s on cold cache).
# It now runs as concurrent child processes, typically 4-6 s wall time.
#
# To bypass all checks in an emergency:    git push --no-verify
# To fix common failures:
#   - external/personal/orqx/cross-refs:    follow the message printed by the guard
#   - manifest drift:                        npm run generate:manifest
#   - cross-IDE drift:                       npm run sync:ide
#

set -e

node bin/utils/pre-push-safety.js

# Run all six lint guards in parallel and aggregate their results.
# Individual failures print to stderr with the guard name so the offending
# rule is still obvious. See scripts/validate-all.js for the guard list.
if ! npm run --silent validate:all; then
  echo ""
  echo "Push blocked: one or more lint guards failed (see output above)."
  echo ""
  echo "Common fixes:"
  echo "  - External framework references:   rewrite in SINAPSE voice"
  echo "  - Personal leaks:                  generalize text, replace absolute paths"
  echo "  - Orchestrator execution verbs:    move execution to a specialist"
  echo "  - Broken cross-refs:               check workflow agent: ids vs registry"
  echo "  - Manifest drift:                  npm run generate:manifest"
  echo "  - Squad YAML drift:                npm run sync:squad-yaml"
  echo ""
  echo "Bypass (emergency only):  git push --no-verify"
  exit 1
fi

# Resolve the upstream ref to diff against. If the branch has no upstream
# (first push), diff against origin/main as a sane default.
upstream="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "origin/main")"

# Cross-IDE parity is conditional: it runs only when at least one agent file
# changed, so a typical push pays zero overhead. If git cannot resolve the
# upstream (truly orphan branch), assume something under agents/ may have
# changed and run the full check.
if changed_files="$(git diff --name-only "$upstream"...HEAD 2>/dev/null)"; then
  case "$changed_files" in
    *".sinapse-ai/development/agents/"*)
      echo "Cross-IDE parity check (agent files changed)..."
      if ! npm run --silent validate:parity:fast; then
        echo ""
        echo "Push blocked: .claude/ or .codex/ is out of sync with .sinapse-ai/development/agents/"
        echo ""
        echo "Fix:"
        echo "  1. npm run sync:ide"
        echo "  2. git add .claude .codex"
        echo "  3. git commit --amend --no-edit   (or a new commit if you prefer)"
        echo "  4. git push"
        echo ""
        echo "Bypass (emergency only):  git push --no-verify"
        exit 1
      fi
      ;;
    *)
      # No agent files touched - skip the parity check entirely
      ;;
  esac
fi
