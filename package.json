{
  "name": "sinapse-ai",
  "version": "1.5.0",
  "description": "SINAPSE AI: Framework de orquestracao de IA — 18 squads, 189 agentes especializados",
  "bin": {
    "sinapse": "bin/sinapse.js",
    "sinapse-ai": "bin/cli.js",
    "sinapse-delegate": "bin/sinapse-delegate.js"
  },
  "preferGlobal": false,
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "bin/",
    "scripts/",
    "packages/",
    ".sinapse-ai/",
    ".claude/CLAUDE.md",
    ".claude/rules/",
    ".claude/hooks/",
    ".codex/catalog.json",
    ".codex/command-registry.json",
    ".codex/delegation-matrix.json",
    ".codex/handoff-packet.schema.json",
    ".codex/instructions.md",
    ".codex/agents/",
    ".codex/scripts/",
    ".codex/skills/",
    ".codex/tasks/",
    "squads/squad-*/**",
    "squads/claude-code-mastery/**",
    "squads/sinapse/**",
    "sinapse/**",
    "docs/guides/",
    "docs/installation/",
    "docs/examples/",
    "docs/community/",
    "docs/legal/",
    "docs/security/",
    "docs/sinapse-workflows/",
    "docs/sinapse-agent-flows/",
    "docs/framework/",
    "docs/en/",
    "docs/pt/",
    "docs/*.md",
    "CHROME-BRAIN-INSTALL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.md\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:health-check": "mocha tests/health-check/**/*.test.js --timeout 30000",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "release:test": "semantic-release --dry-run --no-ci || echo 'Config test complete - authentication errors are expected locally'",
    "generate:manifest": "node scripts/generate-install-manifest.js",
    "sync:counts": "node scripts/sync-counts.js",
    "validate:article-vii": "node scripts/validate-article-vii.js",
    "validate:article-viii": "node scripts/validate-article-viii.js",
    "validate:article-xi": "node scripts/validate-article-xi.js",
    "reconcile:squads": "node scripts/reconcile-squad-manifests.js",
    "apply:persona-disclaimer": "node scripts/apply-persona-disclaimer.js",
    "validate:manifest": "node scripts/validate-manifest.js",
    "validate:manifest:parity": "node .sinapse-ai/infrastructure/scripts/validate-manifest-parity.js",
    "validate:agents": "node .sinapse-ai/infrastructure/scripts/validate-agents.js",
    "sync:ide": "node .sinapse-ai/infrastructure/scripts/ide-sync/index.js sync",
    "sync:ide:validate": "node .sinapse-ai/infrastructure/scripts/ide-sync/index.js validate",
    "sync:ide:check": "node .sinapse-ai/infrastructure/scripts/ide-sync/index.js validate --strict",
    "sync:ide:claude": "node .sinapse-ai/infrastructure/scripts/ide-sync/index.js sync --ide claude-code",
    "sync:ide:codex": "node .sinapse-ai/infrastructure/scripts/sync-codex-local-first.js",
    "validate:claude-sync": "node .sinapse-ai/infrastructure/scripts/ide-sync/index.js validate --ide claude-code --strict",
    "validate:claude-integration": "node .sinapse-ai/infrastructure/scripts/validate-claude-integration.js",
    "validate:codex-sync": "node .sinapse-ai/infrastructure/scripts/validate-codex-sync.js",
    "validate:codex-integration": "node .sinapse-ai/infrastructure/scripts/validate-codex-integration.js",
    "validate:codex-commands": "node .sinapse-ai/infrastructure/scripts/validate-codex-command-registry.js",
    "validate:codex-delegation": "node .sinapse-ai/infrastructure/scripts/validate-codex-delegation.js",
    "sync:skills:codex": "node .sinapse-ai/infrastructure/scripts/codex-skills-sync/index.js",
    "sync:skills:codex:global": "node .sinapse-ai/infrastructure/scripts/codex-skills-sync/index.js --global --global-only",
    "validate:codex-skills": "node .sinapse-ai/infrastructure/scripts/codex-skills-sync/validate.js --strict",
    "validate:paths": "node .sinapse-ai/infrastructure/scripts/validate-paths.js",
    "validate:parity": "node .sinapse-ai/infrastructure/scripts/validate-parity.js",
    "validate:parity:fast": "node .sinapse-ai/infrastructure/scripts/validate-parity.js --fast --quiet",
    "collab:adopt": "node bin/utils/collab-start.js --adopt-current",
    "collab:check": "node bin/utils/collab-start.js --check",
    "collab:start": "node bin/utils/collab-start.js",
    "validate:semantic-lint": "node scripts/semantic-lint.js",
    "validate:docs": "node scripts/validate-install-docs.js",
    "validate:no-external-refs": "node scripts/validate-no-external-refs.js",
    "validate:no-personal-leaks": "node scripts/validate-no-personal-leaks.js",
    "validate:orqx-discipline": "node scripts/validate-orqx-discipline.js",
    "validate:cross-refs": "node scripts/validate-cross-refs.js",
    "validate:all": "node scripts/validate-all.js",
    "sync:squad-yaml": "node scripts/sync-squad-yaml-components.js",
    "validate:squad-yaml": "node scripts/sync-squad-yaml-components.js --check",
    "validate:story-meta": "node scripts/validate-story-meta.js",
    "validate:squad-orqx": "node scripts/validate-squad-orqx.js",
    "validate:release-readiness": "node scripts/release-readiness.js",
    "manifest:ensure": "node scripts/ensure-manifest.js",
    "validate:publish": "node bin/utils/validate-publish.js",
    "brand": "node scripts/sinapse-patch.js",
    "prepublishOnly": "node bin/utils/validate-publish.js && npm run generate:manifest && npm run validate:manifest",
    "postinstall": "node bin/postinstall.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "asciichart": "^1.5.25",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "execa": "^5.1.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.2",
    "glob": "^10.4.4",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.6",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.7.2",
    "tar": "^7.5.13",
    "yaml": "^2.8.3"
  },
  "keywords": [
    "ai",
    "sinapse",
    "agile",
    "agents",
    "orchestrator",
    "fullstack",
    "development",
    "cli",
    "cross-platform",
    "interactive",
    "wizard",
    "modern-ux",
    "vite-style",
    "automation"
  ],
  "author": "SINAPSE Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioimori/sinapse-ai.git"
  },
  "bugs": {
    "url": "https://github.com/caioimori/sinapse-ai/issues"
  },
  "homepage": "https://github.com/caioimori/sinapse-ai#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9.38.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.1.1",
    "mocha": "^11.7.5",
    "prettier": "^3.5.3",
    "semantic-release": "^25.0.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix --cache --cache-location .eslintcache",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write",
      "node scripts/semantic-lint.js --staged"
    ],
    ".sinapse-ai/development/agents/*.md": [
      "npm run sync:ide"
    ],
    "docs/stories/*.story.md": [
      "node scripts/validate-story-meta.js --staged"
    ]
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5",
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.5",
    "fast-uri": "^3.1.2",
    "ip-address": "^10.1.1"
  }
}
