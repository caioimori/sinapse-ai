{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Handoff Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "mission",
    "owner",
    "inputs",
    "outputs",
    "validators"
  ],
  "properties": {
    "routeId": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sharedSurfaceRisk": {
      "type": "string"
    },
    "shared-surface-risk": {
      "type": "string",
      "enum": ["none", "codex-only", "shared-review-required", "low"]
    },
    "nextHandoff": {
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "artifact": { "type": "string" }
      }
    },
    "next-handoff": {
      "type": "string",
      "minLength": 1
    },
    "delegationChain": {
      "type": "array"
    },
    "resources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
