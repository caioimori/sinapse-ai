{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Handoff Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission",
    "phase",
    "owner",
    "inputs",
    "outputs",
    "validators",
    "shared-surface-risk",
    "next-handoff"
  ],
  "properties": {
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shared-surface-risk": {
      "type": "string",
      "enum": ["none", "codex-only", "shared-review-required"]
    },
    "next-handoff": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
