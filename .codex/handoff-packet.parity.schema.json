{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Delegation Handoff Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission",
    "phase",
    "owner",
    "classification",
    "inputs",
    "outputs",
    "validators",
    "sharedSurfaceRisk",
    "nextHandoff",
    "delegationChain"
  ],
  "properties": {
    "routeId": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "enum": ["validator-backed", "codex-only-shim", "exploratory"]
    },
    "summary": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sharedSurfaceRisk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "nextHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "artifact"],
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delegationChain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "fromType", "to", "toType", "handoff", "reason"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "fromType": {
            "type": "string",
            "enum": ["orqx", "framework-agent", "specialist"]
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "toType": {
            "type": "string",
            "enum": ["orqx", "framework-agent", "specialist"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "resolver": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "handoff": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
