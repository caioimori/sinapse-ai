# LLM Routing Environment Variables
# Copy this file to .env and fill in your API keys

# DeepSeek API Key (primary - recommended)
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenRouter API Key (optional - for fallback)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq API Key (optional)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# LiteLLM Master Key - REQUIRED. No default is provided on purpose.
# Generate a strong random value, e.g.:
#   openssl rand -hex 32   (then prefix with "sk-")  ->  sk-<random>
# Never commit the real key, and never reuse this placeholder.
# Also: do NOT expose the LiteLLM port (4000) publicly — keep it bound to
# localhost / an internal network. Anyone with the port + this key has full
# routing access.
LITELLM_MASTER_KEY=CHANGE_ME

# Logging level (DEBUG, INFO, WARNING, ERROR)
LITELLM_LOG_LEVEL=INFO
